# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# 실행 중 생성되는 파일
# ---------------------------------------------------------------------------
logs/
archive/
*.log

# 업무 데이터가 실수로 커밋되는 것을 막습니다.
*.xlsx
*.xlsm
*.xls
*.csv
~$*
# 단, 테스트가 만들어 쓰는 샘플은 애초에 tests/ 아래 임시로만 생성됩니다.

